            {
              "name": "Crear crédito aprobado (Tasa 8%)",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test(\"Status 200\", function () {\r",
                      "    pm.response.to.have.status(200);\r",
                      "});\r",
                      "\r",
                      "const response = pm.response.json();\r",
                      "\r",
                      "pm.test(\"Credito aprobado\", function () {\r",
                      "    pm.expect(response.approved).to.eql(true);\r",
                      "});\r",
                      "\r",
                      "pm.test(\"Estado APPROVED\", function () {\r",
                      "    pm.expect(response.status).to.eql(\"APPROVED\");\r",
                      "});\r",
                      "\r",
                      "pm.test(\"Tasa 8%\", function () {\r",
                      "    pm.expect(response.interestRate).to.eql(8);\r",
                      "});\r",
                      "\r",
                      "pm.environment.set(\"loanId\", response.id);"
                    ],
                    "type": "text/javascript",
                    "packages": {},
                    "requests": {}
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [],
